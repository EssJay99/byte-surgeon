{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Configuration",
  "description": "Schema for plugin configuration files",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "entry_point"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for the plugin",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the plugin",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the plugin"
        },
        "author": {
          "type": "string",
          "description": "Author or maintainer of the plugin"
        },
        "entry_point": {
          "type": "string",
          "description": "Name of the function to create plugin instance",
          "default": "create_plugin"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "Plugin-specific configuration settings",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
